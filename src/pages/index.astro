				</p>
				<a href="mailto:fizcode.dev@gmail.com" class="btn contact-btn"
					>Say hello</a
				>
			</div>
		</div>
	</section>
</Layout>

<script>
	/*
	 * When the Design view appears, the spec values scramble and then settle on the real ones,
	 * left to right: digits through random digits, names through random letters.
	 */
	const targets = Array.from(
		document.querySelectorAll<HTMLElement>("[data-scramble]"),
	);
	const designRadio = document.getElementById(
		"view-design",
	) as HTMLInputElement | null;
	const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

	const DURATION = 900; // ms, matched to the view's fade-in
	const FRAME = 45; // ms between changes, so the scramble stays readable
	const LETTERS = "abcdefghijklmnopqrstuvwxyz";

	const finals = targets.map((el) => el.textContent ?? "");
	const pick = (chars: string) =>
		chars[Math.floor(Math.random() * chars.length)];

	// A random stand-in of the same kind, so the text keeps its shape
	const randomLike = (char: string) => {
		if (/[0-9]/.test(char)) return pick("0123456789");
		if (/[A-Z]/.test(char)) return pick(LETTERS).toUpperCase();
		if (/[a-z]/.test(char)) return pick(LETTERS);
		return char;
	};

	let frame = 0;

	const showFinal = () =>
		targets.forEach((el, i) => (el.textContent = finals[i]));

	const scramble = () => {
		cancelAnimationFrame(frame);
		if (reducedMotion.matches) return showFinal();

		const start = performance.now();
		let last = -Infinity;

		const tick = (now: number) => {
			const progress = Math.min((now - start) / DURATION, 1);
			if (progress === 1) return showFinal();

			if (now - last >= FRAME) {
				last = now;
				// Nothing settles for the first 30%; then characters lock in from the left
				const settle = Math.max(0, (progress - 0.3) / 0.7);
				targets.forEach((el, i) => {
					const final = finals[i];
					const settled = Math.floor(settle * final.length);
					el.textContent =
						final.slice(0, settled) +
						[...final.slice(settled)].map(randomLike).join("");
				});
			}
			frame = requestAnimationFrame(tick);
		};
		frame = requestAnimationFrame(tick);
	};

	designRadio?.addEventListener(
		"change",
		() => designRadio.checked && scramble(),
	);
	if (designRadio?.checked) scramble();

	/*
	 * When the Code view appears, the source builds up line by line in nesting order (see
	 * salesCardLines), and "recomposed ×1" lights up last.
	 */
	const codeRadio = document.getElementById(
		"view-code",
	) as HTMLInputElement | null;
	const panel = document.querySelector<HTMLElement>("[data-code-panel]");

	const STEP_DELAY = 260; // ms between steps
	const FIRST_STEP = 200; // ms, once the panel has started fading in

	let timers: number[] = [];

	const buildCode = () => {
		if (!panel) return;
		const lines = Array.from(panel.querySelectorAll<HTMLElement>(".ln"));
		const recomposed = panel.querySelector<HTMLElement>("[data-recomposed]")!;
		const lastStep = Math.max(...lines.map((line) => Number(line.dataset.step)));

		timers.forEach(clearTimeout);
		timers = [];

		if (reducedMotion.matches) {
			panel.classList.remove("animated");
			return;
		}

		// Close everything instantly, then open it again one step at a time
		panel.classList.add("animated", "resetting");
		lines.forEach((line) => line.classList.remove("shown"));
		recomposed.classList.remove("shown");
		void panel.offsetWidth;
		panel.classList.remove("resetting");

		for (let step = 0; step <= lastStep; step++) {
			timers.push(
				window.setTimeout(() => {
					lines
						.filter((line) => Number(line.dataset.step) === step)
						.forEach((line) => line.classList.add("shown"));
				}, FIRST_STEP + step * STEP_DELAY),
			);
		}
		timers.push(
			window.setTimeout(
				() => recomposed.classList.add("shown"),
				FIRST_STEP + (lastStep + 1) * STEP_DELAY + 150,
			),
		);
	};

	codeRadio?.addEventListener("change", () => codeRadio.checked && buildCode());
	if (codeRadio?.checked) buildCode();
</script>

<style>
	/*
	 * ---------- Design / Code ----------
	 * The header's radios set the view. Design is the default look; every rule starting with
	 * :global(html:has(#view-code:checked)) is the Code view. Properties that differ between the two
	 * transition, so switching morphs the hero instead of swapping it.
	 */
	.hero {
		--morph: 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
		/* How far the source panel reaches below the stage once fully built */
		--panel-drop: 90px;
	}

	.stage,
	.stage *,
	.mode-note {
		transition:
			width var(--morph),
			height var(--morph),
			margin var(--morph),
			padding var(--morph),
			gap var(--morph),
			border-radius var(--morph),
			font-size var(--morph),
			outline-color var(--morph),
			outline-width var(--morph),
			opacity var(--morph),
			transform var(--morph),
			visibility var(--morph);
	}

	/* ---------- Hero ---------- */
	/* Each view's grid is its own layer, so switching crossfades them */
	.hero {
		position: relative;
		isolation: isolate;
		border-bottom: 1px solid var(--hero-design-border);
		transition: border-color var(--morph);
	}

	.hero::before,
	.hero::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		transition: opacity var(--morph);
	}

	/* Design: a red 8px redline grid */
	.hero::before {
		background-color: var(--hero-design-bg);
		background-image:
			linear-gradient(var(--hero-design-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--hero-design-line) 1px, transparent 1px);
		background-size: 8px 8px;
	}

	/* Code: a blue 24px layout grid */
	.hero::after {
		background-color: var(--hero-code-bg);
		background-image:
			linear-gradient(var(--hero-code-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--hero-code-line) 1px, transparent 1px);
		background-size: 24px 24px;
		opacity: 0;
	}

	:global(html:has(#view-code:checked)) .hero {
		border-bottom-color: var(--hero-code-border);
	}

	:global(html:has(#view-code:checked)) .hero::after {
		opacity: 1;
	}

	.hero-container {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 3.5rem;
		padding-top: 4rem;
		padding-bottom: 6rem;
		transition: padding var(--morph);
	}

	/* Room below for the source panel, which hangs past the bottom of the stage */
	:global(html:has(#view-code:checked)) .hero-container {
		padding-bottom: calc(6rem + var(--panel-drop));
	}

	.hero-content {
		flex: 1 1 460px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.hero-title {
		font-size: clamp(2.75rem, 6vw, 4.25rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
	}

	.hero-subtitle {
		max-width: 520px;
		font-size: 1.1875rem;
		line-height: 1.55;
		color: var(--color-text-body);
	}

	/* Both notes share one spot and crossfade */
	.mode-notes {
		display: grid;
	}

	.mode-note {
		grid-area: 1 / 1;
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.875rem;
		color: var(--color-spec-text);
	}

	.note-code,
	:global(html:has(#view-code:checked)) .note-design {
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px);
	}

	:global(html:has(#view-code:checked)) .note-code {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	.note-code {
		color: var(--color-code-text);
	}

	.dot {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-spec);
	}

	.note-code .dot {
		background: var(--color-code);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.hero-visual {
		flex: 1 1 440px;
		min-width: 0;
		display: flex;
		justify-content: center;
	}

	/* The phone, the spec labels around it and the source panel share one fixed-size stage */
	.stage {
		position: relative;
		width: 460px;
		max-width: 100%;
		height: 600px;
	}

	/* ---------- The phone: big with redlines in Design, smaller with bounds in Code ---------- */
	.phone {
		position: relative;
		width: 300px;
		height: 580px;
		margin-left: 60px;
		box-sizing: border-box;
		padding: 28px 16px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		overflow: hidden;
		border: 10px solid var(--color-phone-frame);
		border-radius: 44px;
		background: #fbfaf6;
		color: #16181d;
	}

	:global(html:has(#view-code:checked)) .phone {
		width: 250px;
		height: 500px;
		margin-left: 0;
		padding: 24px 12px;
		gap: 12px;
		border-radius: 40px;
	}

	.screen-title {
		font-size: 13px;
		color: #6a6d75;
	}

	.sales-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px;
		border-radius: 28px;
		background: #e8efe9;
	}

	.sales-label {
		font-size: 13px;
		color: #3e5a48;
	}

	.sales-label.small {
		font-size: 12px;
	}

	.sales-total {
		font-size: 26px;
		font-weight: 600;
	}

	.sales-list-wrap {
		position: relative;
	}

	.sales-list {
		display: flex;
		flex-direction: column;
		list-style: none;
	}

	.sales-list li {
		display: flex;
		justify-content: space-between;
		padding: 12px 4px;
		font-size: 14px;
	}

	.sales-list li + li {
		border-top: 1px solid #e4e1d7;
	}

	.sale-btn {
		margin-top: auto;
		padding: 14px;
		border-radius: 16px;
		background: #2e6b4f;
		color: #fff;
		font-size: 15px;
		font-weight: 500;
		text-align: center;
	}

	:global(html:has(#view-code:checked)) .screen-title {
		font-size: 12px;
	}

	:global(html:has(#view-code:checked)) .sales-card {
		gap: 6px;
		padding: 14px;
		border-radius: 24px;
	}

	:global(html:has(#view-code:checked)) .sales-label {
		font-size: 12px;
	}

	:global(html:has(#view-code:checked)) .sales-label.small {
		font-size: 11px;
	}

	:global(html:has(#view-code:checked)) .sales-total {
		font-size: 22px;
	}

	:global(html:has(#view-code:checked)) .sales-list li {
		padding: 10px 4px;
		font-size: 13px;
	}

	:global(html:has(#view-code:checked)) .sale-btn {
		padding: 12px;
		border-radius: 14px;
		font-size: 14px;
	}

	/* ---------- Outlines: red redlines in Design turn into blue dashed bounds in Code ---------- */
	.box,
	.box-inner {
		outline: 1px dashed transparent;
	}

	.redline {
		outline: 1px solid var(--color-spec);
	}

	:global(html:has(#view-code:checked)) .box {
		outline: 1px dashed var(--color-code);
	}

	:global(html:has(#view-code:checked)) .box-strong {
		outline-width: 1.5px;
	}

	:global(html:has(#view-code:checked)) .box-inner {
		outline-color: #7c95e8;
	}

	.bounds-tag {
		position: absolute;
		top: -9px;
		right: 10px;
		padding: 1px 5px;
		border-radius: 3px;
		background: var(--color-code);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 9px;
		line-height: 1.4;
		opacity: 0;
		transform: scale(0.8);
	}

	/* On the left, clear of the source panel that overlaps the phone's right side */
	.sales-list-wrap .bounds-tag {
		right: auto;
		left: 10px;
	}

	:global(html:has(#view-code:checked)) .bounds-tag {
		opacity: 1;
		transform: none;
	}

	/* ---------- Spec labels around the phone (Design only) ---------- */
	.spec-layer {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	:global(html:has(#view-code:checked)) .spec-layer {
		opacity: 0;
		visibility: hidden;
		transform: translateX(-12px);
	}

	/* Plain text, not flex: flex would drop the spaces between a scrambled value and its neighbours */
	.chip {
		position: absolute;
		display: block;
		line-height: 1.4;
		padding: 2px 6px;
		border-radius: 4px;
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-size: 11px;
		white-space: nowrap;
	}

	.spec-chip {
		border: 1px solid var(--color-spec);
		color: var(--color-spec-text);
	}

	.token-chip {
		border: 1px solid var(--color-border-strong);
		color: var(--color-text-muted);
	}

	.swatch {
		display: inline-block;
		vertical-align: -1px;
