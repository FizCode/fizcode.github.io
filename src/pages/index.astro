---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
	(a, b) => b.data.priority - a.data.priority,
);

// The hero's sample screen, shown in both views
const sales = [
	{ item: "Kopi susu ×2", price: "Rp 36.000" },
	{ item: "Roti bakar", price: "Rp 22.000" },
	{ item: "Teh tarik", price: "Rp 15.000" },
];

// The hero's source panel, hand-highlighted like Android Studio's Islands Dark editor
const kw = (t: string) => `<span class="tk-keyword">${t}</span>`;
const ann = (t: string) => `<span class="tk-annotation">${t}</span>`;
const decl = (t: string) => `<span class="tk-function">${t}</span>`;
const str = (t: string) => `<span class="tk-string">${t}</span>`;
const num = (t: string) => `<span class="tk-number">${t}</span>`;
const prop = (t: string) => `<span class="tk-property">${t}</span>`;
const arg = (t: string) => `<span class="tk-named-arg">${t} =</span>`;

/*
 * One entry per line: [step, html]. The panel builds the code up in nesting order, step by step:
 * the function, then Card, its arguments, Column, its arguments, then each Text. Closing brackets
 * share their opener's step, so they appear together and get pushed down as the inside fills in.
 */
const salesCardLines: [number, string][] = [
	[0, ann("@Composable")],
	[0, `${kw("fun")} ${decl("SalesCard")}(state: SalesState) {`],
	[1, "  Card("],
	[2, `    ${arg("shape")} RoundedCornerShape(${num("28")}.${prop("dp")}),`],
	[3, `    ${arg("colors")} CardDefaults.cardColors(`],
	[4, `      ${arg("containerColor")}`],
	[4, `        CashierTheme.${prop("colors")}.${prop("surfaceContainer")}`],
	[3, "    )"],
	[1, "  ) {"],
	[5, "    Column("],
	[6, `      Modifier.padding(${num("16")}.${prop("dp")}),`],
	[7, `      ${arg("verticalArrangement")}`],
	[7, `        Arrangement.spacedBy(${num("8")}.${prop("dp")})`],
	[5, "    ) {"],
	[8, "      Text("],
	[9, `        ${arg("text")} ${str('"Today\'s sales"')},`],
	[9, `        ${arg("style")} CashierTheme.${prop("type")}.${prop("labelMedium")}`],
	[8, "      )"],
	[10, "      Text("],
	[11, `        ${arg("text")} state.${prop("total")},`],
	[11, `        ${arg("style")} CashierTheme.${prop("type")}.${prop("titleLarge")}`],
	[10, "      )"],
	[5, "    }"],
	[1, "  }"],
	[0, "}"],
];
---

