---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('projects');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

const post = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} - FizCode`} description={post.data.description}>
	<article class="project-detail">
		<div class="container">
			<a href="/#work" class="back-link">← Back to projects</a>
			
			<header class="project-header">
				<h1 class="project-title">{post.data.title}</h1>
				<p class="project-description">{post.data.description}</p>
				<div class="tags">
					{post.data.tags.map(tag => <span class="tag">{tag}</span>)}
				</div>
                {post.data.link && (
                    <a href={post.data.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                        View Live Project
                    </a>
                )}
			</header>
            
            <hr class="divider" />

			<div class="project-content">
				<Content />
			</div>
		</div>
	</article>
</Layout>

<style>
	.project-detail {
		padding: 3rem 0 var(--spacing-xxl);
	}

	.back-link {
		display: inline-block;
		margin-bottom: var(--spacing-xl);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	.project-header {
		max-width: 800px;
		margin: 0 auto var(--spacing-lg);
	}

	.project-title {
		font-size: clamp(2.5rem, 6vw, 3.75rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin-bottom: var(--spacing-sm);
	}

	.project-description {
		font-size: 1.25rem;
		line-height: 1.5;
		color: var(--color-text-body);
		margin-bottom: var(--spacing-md);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: var(--spacing-lg);
	}

	.divider {
		max-width: 800px;
		margin: var(--spacing-lg) auto var(--spacing-xl);
		border: 0;
		border-top: 1px solid var(--color-border);
	}

	.project-content {
		max-width: 800px;
		margin: 0 auto;
		font-size: 1.125rem;
		line-height: 1.75;
		color: var(--color-text-main);
	}

	/* Markdown */
	.project-content :global(h2) {
		font-size: 1.875rem;
		margin-top: var(--spacing-xl);
		margin-bottom: var(--spacing-sm);
	}

	.project-content :global(h3) {
		font-size: 1.375rem;
		margin-top: var(--spacing-lg);
		margin-bottom: var(--spacing-xs);
	}

	.project-content :global(p) {
		margin-bottom: var(--spacing-md);
		color: var(--color-text-body);
	}

	.project-content :global(ul),
	.project-content :global(ol) {
		margin-bottom: var(--spacing-md);
		padding-left: 1.5rem;
		color: var(--color-text-body);
	}

	.project-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.project-content :global(li::marker) {
		color: var(--color-primary);
	}

	.project-content :global(strong) {
		color: var(--color-text-main);
		font-weight: 600;
	}

	.project-content :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.project-content :global(code) {
		padding: 0.1em 0.35em;
		border-radius: 4px;
		background: var(--color-track);
		font-family: var(--font-mono);
		font-size: 0.875em;
	}
</style>
