---
import '../styles/global.css';
import '../styles/portfolio.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	/** Show the Design / Code switch in the header (pages whose content reacts to it) */
	viewToggle?: boolean;
}

const { title, description = "FizCode Portfolio", viewToggle = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="portfolio">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

		<title>{title}</title>

		<!-- Set the theme before first paint to avoid a flash: saved choice, else the system setting -->
		<script is:inline>
			(() => {
				let theme = null;
				try { theme = localStorage.getItem('portfolio-theme'); } catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body>
		<Header viewToggle={viewToggle} />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		min-height: 100vh;
	}
</style>
