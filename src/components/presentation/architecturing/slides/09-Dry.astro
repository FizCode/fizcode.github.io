---
import '../styles/palette.css';
import Slide from '../../Slide.astro';
import SlideHeader from '../../SlideHeader.astro';
import CodeMorph from '../../CodeMorph.astro';
import CodeComparison from '../components/CodeComparison.astro';
import { duplicatedRule, lookAlike, ruleOfThumb } from '../data/dry';
---

<Slide width={170} pinned>
	<SlideHeader
		title="Don't repeat yourself… wisely"
		subtitles={[
			{ name: 'DRY', text: 'every piece of knowledge has one home' },
			{ name: 'DRY', text: 'every piece of knowledge has one home' },
			{ name: 'Not all duplication is bad', text: 'code that looks alike can change for different reasons' },
			{ name: 'Rule of thumb', text: 'ask one question before you merge' },
		]}
	/>

	<!-- Steps, in order: the rule gets one home, look-alike code, the rule of thumb -->
	<div class="dry-clean fragment" hidden></div>
	<div class="alike-step fragment" hidden></div>
	<div class="thumb-step fragment" hidden></div>

	<div class="dry-body">
		<section class="panel panel-rule">
			<CodeMorph trigger="dry-clean" {...duplicatedRule} />
		</section>

		<section class="panel panel-alike">
			<CodeComparison comparison={lookAlike} />
		</section>

		<section class="panel panel-thumb">
			<p class="question">{ruleOfThumb.question}</p>
			<div class="answers">
				{[{ key: 'yes', ...ruleOfThumb.yes }, { key: 'no', ...ruleOfThumb.no }].map((a) => (
					<div class={`answer answer-${a.key}`}>
						<p class="answer-head">{a.answer}</p>
						<p class="answer-action">{a.action}</p>
					</div>
				))}
			</div>
			<blockquote class="quote">
				“{ruleOfThumb.quote}”
				<cite>{ruleOfThumb.author}</cite>
			</blockquote>
		</section>
	</div>
</Slide>

<style>
	/* Sizes scale with the screen; values in comments are at 1920x1080 */
	/* Panels hang from the top, so a changing code block never moves its label */
	.dry-body {
		flex: 1;
		display: grid;
		align-items: start;
		justify-items: center;
		padding-top: clamp(1rem, 7vh, 6rem);
		font-size: clamp(0.9rem, min(2.3vh, 1.3vw), 2.1rem); /* ~25px */
	}

	/* The panels share one spot; each step shows one of them */
	.panel {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1em;
		transition: opacity var(--transition-normal), visibility var(--transition-normal);
	}

	:global(.slide:has(.alike-step.visible)) .panel-rule,
	:global(.slide:not(:has(.alike-step.visible))) .panel-alike,
	:global(.slide:has(.thumb-step.visible)) .panel-alike,
	:global(.slide:not(:has(.thumb-step.visible))) .panel-thumb {
		opacity: 0;
		visibility: hidden;
	}

	/* One code block at a time, so it can be large */
	.panel-rule {
		--code-font: clamp(0.85rem, min(2.4vh, 1.35vw), 2rem); /* ~26px */
	}

	/* ---------- Rule of thumb ---------- */
	.question {
		font-family: var(--font-display);
		font-size: 1.6em; /* ~40px */
		font-weight: 700;
		text-align: center;
	}

	.answers {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.2em;
		width: min(100%, 52em);
	}

	.answer {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
		padding: 1em 1.3em;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-top: 5px solid var(--c-answer);
		border-radius: var(--radius-md);
	}

	.answer-yes { --c-answer: var(--c-app); }
	.answer-no { --c-answer: var(--c-presentation); }

	.answer-head {
		font-weight: 700;
		color: var(--c-answer);
	}

	.answer-action {
		font-size: 1.1em;
		font-weight: 600;
		line-height: 1.35;
	}

	.quote {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3em;
		margin-top: 0.6em;
		font-size: 1.15em;
		font-style: italic;
		color: var(--color-text-main);
		text-align: center;
	}

	.quote cite {
		font-size: 0.8em;
		font-style: normal;
		color: var(--color-text-muted);
	}

	@media (max-width: 800px) {
		.answers {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.panel {
			transition: none;
		}
	}
</style>
