---
import '../styles/palette.css';
import Slide from '../../Slide.astro';
import SlideHeader from '../../SlideHeader.astro';
import DependencyArrow from '../../DependencyArrow.astro';
import ModuleNode from '../components/ModuleNode.astro';
import { niaApp, niaFeatures, niaCore, niaOther } from '../data/nia';
---

<!-- Side slide, opened from "Module structure": the same idea in a real project -->
<Slide side="nia-modules" width="full" gap="sm" pinned data-nia>
	<SlideHeader
		title="Now in Android"
		subtitles={[{ name: 'Google’s reference app', text: 'each feature is split into :api and :impl; data and domain are shared in :core' }]}
	/>

	<div class="board">
		<div class="column column-other">
			<p class="column-label">Around the app</p>
			{niaOther.map((node) => <ModuleNode node={node} />)}
		</div>

		<div class="column column-main">
			<ModuleNode node={niaApp} />
			<DependencyArrow direction="down" />
			<div class="panel panel-features">
				<p class="column-label module-label">:feature</p>
				<ul class="feature-list">
					{niaFeatures.map(({ node, parts }) => (
						<li class="feature">
							<ModuleNode node={node} />
							<span class="link" aria-hidden="true"></span>
							<div class="parts">
								{parts.map((part) => <ModuleNode node={part} />)}
							</div>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class="column column-core">
			<p class="column-label module-label">:core</p>
			<div class="core-groups">
				{niaCore.map((group) => (
					<div class="core-group">
						<p class="group-label">{group.label}</p>
						{group.nodes.map((node) => <ModuleNode node={node} />)}
					</div>
				))}
			</div>
		</div>
	</div>

	<div class="note" aria-live="polite">
		<strong class="note-name" data-note-name></strong>
		<p class="note-text" data-note-text>Click a module to see what it holds</p>
	</div>
</Slide>

<script>
	import { onSlideClick, onSlideReset } from '../../slide-events';

	document.querySelectorAll<HTMLElement>('[data-nia]').forEach((root) => {
		const slide = root.closest<HTMLElement>('.slide')!;
		const name = root.querySelector<HTMLElement>('[data-note-name]')!;
		const text = root.querySelector<HTMLElement>('[data-note-text]')!;
		const hint = text.textContent;
		let selected: HTMLElement | null = null;

		const select = (box: HTMLElement | null) => {
			selected?.classList.remove('selected');
			selected = box;
			box?.classList.add('selected');
			name.textContent = box?.dataset.name ?? '';
			text.textContent = box?.dataset.description ?? hint;
		};

		onSlideClick<HTMLElement>(slide, '[data-node]', {
			onItem: select,
			onOutside: () => select(null),
			hasSelection: () => !!selected,
		});
		onSlideReset(slide, () => select(null));
	});
</script>

<style>
	/* Sizes scale with the screen; values in comments are at 1920x1080 */
	.board {
		flex: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: start;
		gap: clamp(0.75rem, 1.6vw, 2.5rem);
		font-size: clamp(0.85rem, min(2.2vh, 1.25vw), 2rem); /* ~24px */
		--arrow-length: clamp(1.5rem, 4.5vh, 3.5rem);
		--arrow-margin: 0;
	}

	/* More modules than the Module structure slide, so smaller boxes than ModuleNode's default */
	.board :global(.box),
	.board :global(.node[data-kind='package'] > .box) {
		padding: 0.4em 0.7em;
		font-size: clamp(0.8rem, min(2.1vh, 1.2vw), 1.9rem); /* ~23px */
	}

	.column {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5em;
	}

	.column-other {
		justify-self: end;
	}

	.column-core {
		justify-self: start;
	}

	.column-label,
	.group-label {
		font-size: 0.8em;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.group-label {
		font-size: 0.65em;
	}

	/* Module names keep their case */
	.module-label {
		font-family: var(--font-mono);
		font-weight: 600;
		text-transform: none;
		letter-spacing: 0;
	}

	/* The boxes in a stack share the widest one's width */
	.column-other,
	.core-group {
		align-items: stretch;
	}

	.column-other :global(.box),
	.core-group :global(.box) {
		width: 100%;
		justify-content: center;
	}

	.panel,
	.column-core {
		padding: 0.6em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	.panel-features {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5em;
		background: color-mix(in srgb, var(--c-feature) 6%, transparent);
	}

	.column-core {
		background: color-mix(in srgb, var(--c-core) 6%, transparent);
	}

	/* One row per feature: its box, a line, then its :api / :impl submodules */
	.feature-list {
		list-style: none;
		display: grid;
		grid-template-columns: auto auto 1fr;
		align-items: center;
		row-gap: 0.35em;
	}

	.feature {
		display: contents;
	}

	.feature > :global(.node) {
		align-items: stretch;
	}

	.feature > :global(.node > .box) {
		justify-content: center;
	}

	.link {
		width: 1em;
		height: 2px;
		background: var(--color-text-muted);
	}

	.parts {
		display: flex;
		gap: 0.35em;
	}

	.core-groups {
		display: grid;
		grid-template-columns: repeat(2, auto);
		gap: 0.6em 0.8em;
	}

	/* Data is the tallest group: it takes the first column, the others stack beside it */
	.core-group:first-child {
		grid-row: span 2;
	}

	.core-group {
		display: flex;
		flex-direction: column;
		gap: 0.35em;
	}

	/* What the clicked module holds, under the diagram */
	.note {
		align-self: center;
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		width: min(100%, 60em);
		min-height: 3.6em;
		padding: 0.6em 1.2em;
		background: var(--color-surface);
		border-left: 4px solid var(--color-primary);
		border-radius: var(--radius-sm);
		font-size: clamp(0.9rem, min(2.1vh, 1.2vw), 2rem); /* ~23px */
		line-height: 1.4;
	}

	.note-name {
		font-family: var(--font-mono);
		color: var(--color-primary);
	}

	.note-name:empty {
		display: none;
	}

	.note-text {
		color: var(--color-text-main);
	}

	/* Narrow screens: stack the columns, main tree first */
	@media (max-width: 800px) {
		.board {
			display: flex;
			flex-direction: column;
			align-items: stretch;
		}

		.column-main {
			order: -1;
			align-items: stretch;
		}

		.column-other,
		.column-core {
			justify-self: auto;
			align-items: stretch;
		}

		.feature-list {
			grid-template-columns: auto 1fr;
		}

		.link {
			display: none;
		}

		.core-groups {
			grid-template-columns: 1fr;
		}

		.core-group:first-child {
			grid-row: auto;
		}
	}
</style>
