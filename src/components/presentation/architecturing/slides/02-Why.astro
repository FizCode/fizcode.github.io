---
import '../styles/palette.css';
import Slide from '../../Slide.astro';
import SlideHeader from '../../SlideHeader.astro';
import { icons, benefits, monolithParts, monolithTangles } from '../data/why';

const at = (id: string) => monolithParts.find((p) => p.id === id)!;
---

<Slide width={170} gap="lg" pinned>
	<SlideHeader title="Why modularize?" subtitles={['So the codebase can grow without slowing the team down']} />

	<div class="why-body">
		<div class="compare">
			<figure class="panel panel-bad">
				<svg viewBox="0 0 400 200" role="img" aria-labelledby="monolith-title">
					<title id="monolith-title">A monolith: eight parts wired to each other in a tangle</title>
					<rect class="frame" x="4" y="4" width="392" height="192" rx="14" />
					{monolithTangles.map(([a, b]) => (
						<line class="tangle" x1={at(a).x} y1={at(a).y} x2={at(b).x} y2={at(b).y} />
					))}
					{monolithParts.map((p) => (
						<g>
							<rect class="part" x={p.x - 34} y={p.y - 14} width="68" height="28" rx="6" />
							<text class="part-label" x={p.x} y={p.y}>{p.label}</text>
						</g>
					))}
				</svg>
				<figcaption>
					<strong>Monolith</strong>
					<span>Everything can reach everything. One change rebuilds and retests it all.</span>
				</figcaption>
			</figure>

			<div class="fragment compare-after">
				<p class="transition" aria-hidden="true"><span>modularize</span><span class="transition-arrow">→</span></p>

				<figure class="panel panel-good">
					<svg viewBox="0 0 400 200" role="img" aria-labelledby="modular-title">
						<title id="modular-title">Modular: :app depends on three features, which depend on :core</title>
						<defs>
							<marker id="why-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
								<path class="arrowhead" d="M0 0 10 5 0 10z" />
							</marker>
						</defs>
						{[90, 200, 310].map((x) => (
							<>
								<line class="dep" x1="200" y1="46" x2={x} y2="82" marker-end="url(#why-arrow)" />
								<line class="dep" x1={x} y1="118" x2={x === 200 ? 200 : (x + 200) / 2} y2="152" marker-end="url(#why-arrow)" />
							</>
						))}
						<rect class="mod mod-app" x="155" y="14" width="90" height="32" rx="6" />
						<text class="mod-label" x="200" y="30">:app</text>
						{[['A', 90], ['B', 200], ['C', 310]].map(([n, x]) => (
							<g>
								<rect class="mod mod-feature" x={Number(x) - 50} y="86" width="100" height="32" rx="6" />
								<text class="mod-label" x={x} y="102">:feature{n}</text>
							</g>
						))}
						<rect class="mod mod-core" x="110" y="156" width="180" height="32" rx="6" />
						<text class="mod-label" x="200" y="172">:core</text>
					</svg>
					<figcaption>
						<strong>Modular</strong>
						<span>Clear edges, one-way dependencies. A change rebuilds only what depends on it.</span>
					</figcaption>
				</figure>
			</div>
		</div>

		<ul class="benefits">
			{benefits.map((b) => (
				<li class="benefit fragment">
					<span class="icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" set:html={icons[b.icon]} />
					</span>
					<div>
						<h3>{b.title}</h3>
						<p>{b.text}</p>
					</div>
				</li>
			))}
		</ul>
	</div>
</Slide>

<style>
	/* Sizes scale with the screen; values in comments are at 1920x1080 */
	.why-body {
		display: flex;
		flex-direction: column;
		gap: clamp(1rem, 3vh, 2.5rem);
	}

	/*
	 * Before -> after. The monolith starts alone in the middle; when revealed, the
	 * "after" side grows from zero width to half, pushing the monolith to the left.
	 * Its content keeps its final width (cqw = % of .compare) so nothing reflows while it grows.
	 */
	.compare {
		--mid: clamp(6rem, 10vw, 12rem);
		container-type: inline-size;
		display: flex;
		justify-content: center;
		align-items: stretch;
	}

	.compare > .panel {
		flex: none;
		width: 50cqw;
	}

	.compare .compare-after {
		flex: 0 0 0%;
		display: flex;
		align-items: stretch;
		overflow: hidden;
		transition: flex-basis 0.6s ease, opacity 0.4s ease 0.2s, transform 0.4s ease 0.2s, visibility 0.6s;
	}

	.compare .compare-after.visible {
		flex-basis: 50cqw;
	}

	.compare-after > .panel {
		flex: none;
		width: calc(50cqw - var(--mid));
	}

	.panel {
		padding: 0.8em;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		font-size: clamp(0.85rem, min(2.1vh, 1.2vw), 1.9rem); /* ~23px */
	}

	.panel svg {
		display: block;
		width: 100%;
		height: auto;
		max-height: 22vh;
	}

	.panel figcaption {
		display: flex;
		flex-direction: column;
		gap: 0.15em;
		margin-top: 0.5em;
		color: var(--color-text-muted);
		line-height: 1.35;
	}

	.panel figcaption strong {
		font-family: var(--font-display);
		font-size: 1.15em;
	}

	.panel-bad figcaption strong { color: var(--c-bad); }
	.panel-good figcaption strong { color: var(--c-app); }

	.transition {
		flex: none;
		width: var(--mid);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 0.2em;
		color: var(--color-text-muted);
		font-size: clamp(0.85rem, min(2vh, 1.15vw), 1.8rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.transition-arrow {
		font-size: 2em;
		line-height: 1;
	}

	/* SVG drawing; font sizes are in viewBox units so they scale with the picture */
	.frame {
		fill: none;
		stroke: var(--c-bad);
		stroke-width: 2;
		stroke-dasharray: 6 5;
		opacity: 0.6;
	}

	.tangle {
		stroke: var(--c-bad);
		stroke-width: 1.5;
		opacity: 0.55;
	}

	.part {
		fill: var(--color-surface-hover);
		stroke: var(--color-border);
		stroke-width: 1.5;
	}

	.part-label,
	.mod-label {
		fill: var(--color-text-main);
		font-size: 14px;
		text-anchor: middle;
		dominant-baseline: central;
	}

	.part-label {
		font-family: var(--font-sans);
		font-weight: 600;
	}

	.mod {
		fill: var(--color-surface);
		stroke-width: 2;
	}

	.mod-app { stroke: var(--c-app); }
	.mod-feature { stroke: var(--c-feature); }
	.mod-core { stroke: var(--c-core); }

	.mod-label {
		font-family: var(--font-mono);
		font-weight: 700;
	}

	.dep {
		stroke: var(--color-text-muted);
		stroke-width: 2;
	}

	.arrowhead {
		fill: var(--color-text-muted);
	}

	/* Benefits */
	.benefits {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.75rem, 2vh, 1.5rem);
	}

	.benefit {
		display: flex;
		gap: 0.75em;
		align-items: flex-start;
		padding: 0.9em 1em;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		font-size: clamp(0.85rem, min(2.2vh, 1.25vw), 2rem); /* ~24px */
	}

	.icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.4em;
		height: 2.4em;
		border-radius: var(--radius-full);
		background: color-mix(in srgb, var(--c-app) 14%, transparent);
		color: var(--c-app);
	}

	.icon svg {
		width: 1.3em;
		height: 1.3em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.benefit h3 {
		margin-bottom: 0.2em;
		font-size: 1.2em; /* ~29px */
	}

	.benefit p {
		color: var(--color-text-muted);
		line-height: 1.4;
	}

	@media (max-width: 800px) {
		.compare,
		.compare .compare-after {
			flex-direction: column;
		}

		/* Stacked on phones: full-width panels, the modular one simply fades in below */
		.compare > .panel,
		.compare-after > .panel,
		.transition {
			width: auto;
		}

		.compare .compare-after,
		.compare .compare-after.visible {
			flex-basis: auto;
		}

		.transition {
			padding: 0.5em 0;
		}

		.transition-arrow {
			transform: rotate(90deg);
		}

		.benefits {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.compare .compare-after {
			transition: none;
		}
	}
</style>
