---
import '../styles/palette.css';
import SlideHeader from '../../SlideHeader.astro';
import DependencyArrow from '../../DependencyArrow.astro';
import ModuleNode from './ModuleNode.astro';
import type { QitaData } from '../data/qita';

interface Props {
	qita: QitaData;
}

const { qitaApp, qitaFeatures, qitaShared, qitaCore, qitaTooling, qitaDesignSystem } = Astro.props.qita;

// The group with the most modules takes the full height of its column
const tallest = Math.max(...qitaCore.map((group) => group.nodes.length));
---

<!-- The Qita slide's content, rendered inside Locked: it reaches the page only encrypted -->
<SlideHeader
	title="Qita"
	subtitles={[
		{
			name: 'Our app',
			text: 'older products are one module each; newer features split into :data and :presentation',
		},
	]}
/>

<div class="board">
	<div class="column column-side">
		<div class="panel panel-shared">
			<p class="column-label module-label">:shared</p>
			<ul class="module-list">
				{qitaShared.map(({ node, parts }) => (
					<li class="module">
						<ModuleNode node={node} />
						{parts.length > 0 && (
							<>
								<span class="link" aria-hidden="true"></span>
								<div class="parts">
									{parts.map((part) => <ModuleNode node={part} />)}
								</div>
							</>
						)}
					</li>
				))}
			</ul>
		</div>

		<!-- Not a module of this project: pulled in as a dependency -->
		<div class="panel panel-external">
			<p class="column-label">From Artifactory</p>
			<ModuleNode node={qitaDesignSystem} />
		</div>

		<div class="tooling">
			<p class="column-label">Around the app</p>
			<div class="parts">
				{qitaTooling.map((node) => <ModuleNode node={node} />)}
			</div>
		</div>
	</div>

	<div class="column column-main">
		<ModuleNode node={qitaApp} />
		<DependencyArrow direction="down" />
		<div class="panel panel-features">
			<p class="column-label">Features</p>
			{qitaFeatures.map((group) => (
				<div class="feature-group">
					<p class="group-label">{group.label}</p>
					<ul class="module-list">
						{group.modules.map(({ node, parts }) => (
							<li class="module">
								<ModuleNode node={node} />
								<span class="link" aria-hidden="true"></span>
								<div class="parts">
									{parts.map((part) => <ModuleNode node={part} />)}
								</div>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>

	<div class="column column-right">
		<div class="panel panel-core">
			<p class="column-label module-label">:core</p>
			<div class="core-groups">
				{qitaCore.map((group) => (
					<div class:list={['core-group', { tall: group.nodes.length === tallest }]}>
						<p class="group-label">{group.label}</p>
						{group.nodes.map((node) => <ModuleNode node={node} />)}
					</div>
				))}
			</div>
		</div>
	</div>
</div>

<div class="note" aria-live="polite">
	<strong class="note-name" data-note-name></strong>
	<p class="note-text" data-note-text>Click a module to see what it holds</p>
</div>

<style>
	/* Sizes scale with the screen; values in comments are at 1920x1080 */
	.board {
		flex: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: start;
		gap: clamp(0.75rem, 1.6vw, 2.5rem);
		font-size: clamp(0.8rem, min(2vh, 1.15vw), 1.9rem); /* ~22px */
		--arrow-length: clamp(1.25rem, 3.5vh, 3rem);
		--arrow-margin: 0;
	}

	/* The most modules of the three module slides, so the smallest boxes */
	.board :global(.box),
	.board :global(.node[data-kind='package'] > .box) {
		padding: 0.35em 0.6em;
		font-size: clamp(0.72rem, min(1.85vh, 1.05vw), 1.7rem); /* ~20px */
	}

	.column {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5em;
	}

	.column-side {
		justify-self: end;
		align-items: stretch;
	}

	.column-right {
		justify-self: start;
		align-items: stretch;
	}

	.column-label,
	.group-label {
		font-size: 0.8em;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.group-label {
		font-size: 0.65em;
	}

	/* Module names keep their case */
	.module-label {
		font-family: var(--font-mono);
		font-weight: 600;
		text-transform: none;
		letter-spacing: 0;
	}

	.panel {
		padding: 0.6em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	.panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5em;
	}

	.panel-features {
		background: color-mix(in srgb, var(--c-feature) 6%, transparent);
	}

	.panel-shared,
	.panel-core {
		background: color-mix(in srgb, var(--c-core) 6%, transparent);
	}

	/* Outside the project: dashed, and set apart from :core */
	.panel-external {
		border-style: dashed;
	}

	.feature-group {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.35em;
		width: 100%;
	}

	.feature-group + .feature-group {
		padding-top: 0.5em;
		border-top: 1px dashed var(--color-border);
	}

	/* One row per module: its box, a line, then its submodules or packages */
	.module-list {
		list-style: none;
		display: grid;
		grid-template-columns: auto auto 1fr;
		align-items: center;
		row-gap: 0.35em;
	}

	.module {
		display: contents;
	}

	/* A module without parts still starts its own row */
	.module > :global(.node) {
		grid-column: 1;
		align-items: stretch;
	}

	.module > :global(.node > .box) {
		justify-content: center;
	}

	.link {
		width: 1em;
		height: 2px;
		background: var(--color-text-muted);
	}

	.parts {
		display: flex;
		gap: 0.35em;
	}

	.tooling {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35em;
	}

	.tooling .parts {
		flex-wrap: wrap;
		justify-content: center;
	}

	/* The boxes in a stack share the widest one's width */
	.core-group {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.35em;
	}

	.core-group :global(.box) {
		width: 100%;
		justify-content: center;
	}

	.core-groups {
		display: grid;
		grid-template-columns: repeat(2, auto);
		grid-auto-flow: dense;
		gap: 0.6em 0.8em;
	}

	/* The tallest group takes the first column, the others stack beside it */
	.core-group.tall {
		grid-column: 1;
		grid-row: span 2;
	}

	/* What the clicked module holds, under the diagram */
	.note {
		align-self: center;
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		width: min(100%, 60em);
		min-height: 3.6em;
		padding: 0.6em 1.2em;
		background: var(--color-surface);
		border-left: 4px solid var(--color-primary);
		border-radius: var(--radius-sm);
		font-size: clamp(0.9rem, min(2.1vh, 1.2vw), 2rem); /* ~23px */
		line-height: 1.4;
	}

	.note-name {
		font-family: var(--font-mono);
		color: var(--color-primary);
	}

	.note-name:empty {
		display: none;
	}

	.note-text {
		color: var(--color-text-main);
	}

	/* Narrow screens: stack the columns, main tree first */
	@media (max-width: 800px) {
		.board {
			display: flex;
			flex-direction: column;
			align-items: stretch;
		}

		.column-main {
			order: -1;
			align-items: stretch;
		}

		.column-side,
		.column-right {
			justify-self: auto;
			align-items: stretch;
		}

		.module-list {
			grid-template-columns: auto 1fr;
		}

		.link {
			display: none;
		}

		.parts {
			flex-wrap: wrap;
		}

		.core-groups {
			grid-template-columns: 1fr;
		}

		.core-group.tall {
			grid-row: auto;
		}
	}
</style>
