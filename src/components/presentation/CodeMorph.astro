---
import { highlightKotlin } from './highlight';

/**
 * A code block that transforms from `before` into `after` when a slide step is revealed.
 * The two versions are diffed line by line at build time: shared lines stay put, removed
 * lines flash and fold away, new lines grow in. `trigger` is the class of the fragment
 * that switches it (see toggleWithStep).
 */
interface Props {
	before: string;
	after: string;
	trigger: string;
	beforeLabel: string;
	afterLabel: string;
	beforeNote?: string;
	afterNote?: string;
}

const { before, after, trigger, beforeLabel, afterLabel, beforeNote, afterNote } = Astro.props;

type Line = { kind: 'same' | 'removed' | 'added'; text: string };

// Longest common subsequence of lines, then a walk that keeps removals ahead of additions
const diffLines = (a: string[], b: string[]): Line[] => {
	const lcs = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
	for (let i = a.length - 1; i >= 0; i--) {
		for (let j = b.length - 1; j >= 0; j--) {
			lcs[i][j] = a[i] === b[j] ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
		}
	}
	const lines: Line[] = [];
	let i = 0;
	let j = 0;
	while (i < a.length && j < b.length) {
		if (a[i] === b[j]) {
			lines.push({ kind: 'same', text: a[i] });
			i++;
			j++;
		} else if (lcs[i + 1][j] >= lcs[i][j + 1]) {
			lines.push({ kind: 'removed', text: a[i++] });
		} else {
			lines.push({ kind: 'added', text: b[j++] });
		}
	}
	a.slice(i).forEach((text) => lines.push({ kind: 'removed', text }));
	b.slice(j).forEach((text) => lines.push({ kind: 'added', text }));
	return lines;
};

const lines = diffLines(before.trim().split('\n'), after.trim().split('\n'));
---

<div class="morph" data-code-morph data-trigger={trigger}>
	<p class="morph-label">
		<span class="state-before">✕ {beforeLabel}</span>
		<span class="state-after">✓ {afterLabel}</span>
	</p>

	<div class="code-block morph-code">
		{lines.map((line) => (
			<div class={`line line-${line.kind}`}>
				<div class="line-inner" set:html={highlightKotlin(line.text) || ' '} />
			</div>
		))}
	</div>

	{(beforeNote || afterNote) && (
		<p class="morph-note">
			<span class="state-before">{beforeNote}</span>
			<span class="state-after">{afterNote}</span>
		</p>
	)}
</div>

<script>
	import { toggleWithStep } from './slide-events';

	document.querySelectorAll<HTMLElement>('[data-code-morph]').forEach((morph) => {
		toggleWithStep(morph, morph.dataset.trigger!);
	});
</script>

<style>
	.morph {
		--bad: var(--c-bad, #ef4444);
		--good: var(--c-app, #22c55e);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5em;
	}

	/* Label and note: both versions share one spot and swap */
	.morph-label,
	.morph-note {
		display: grid;
	}

	.state-before,
	.state-after {
		grid-area: 1 / 1;
		transition: opacity 0.3s ease, visibility 0.3s;
	}

	.state-after,
	.after .state-before {
		opacity: 0;
		visibility: hidden;
	}

	.after .state-after {
		opacity: 1;
		visibility: visible;
		transition-delay: 0.45s;
	}

	.morph-label {
		font-weight: 700;
	}

	.morph-label .state-before { color: var(--bad); }
	.morph-label .state-after { color: var(--good); }

	.morph-note {
		color: var(--color-text-muted);
	}

	.morph-code {
		border-color: color-mix(in srgb, var(--bad) 55%, var(--color-border));
		transition: border-color 0.5s ease 0.3s;
	}

	.after .morph-code {
		border-color: color-mix(in srgb, var(--good) 55%, var(--color-border));
	}

	/* Each line can fold to zero height; the block keeps the width of its longest line */
	.line {
		display: grid;
		grid-template-rows: 1fr;
		margin: 0 -0.5em;
		padding: 0 0.5em;
		border-radius: 4px;
	}

	.line-inner {
		min-height: 0;
		overflow: hidden;
	}

	.line-added {
		grid-template-rows: 0fr;
		opacity: 0;
	}

	/*
	 * Removed lines flash red, then fold away while the new lines grow in (green flash),
	 * so the block eases from its old height to its new one instead of collapsing first.
	 */
	.after .line-removed {
		animation: line-out 0.8s ease forwards;
	}

	.after .line-added {
		animation: line-in 1.1s ease 0.28s both;
	}

	@keyframes line-out {
		0% { background: transparent; }
		35% { background: color-mix(in srgb, var(--bad) 28%, transparent); grid-template-rows: 1fr; opacity: 1; }
		100% { background: color-mix(in srgb, var(--bad) 28%, transparent); grid-template-rows: 0fr; opacity: 0; }
	}

	@keyframes line-in {
		0% { grid-template-rows: 0fr; opacity: 0; background: color-mix(in srgb, var(--good) 24%, transparent); }
		45% { grid-template-rows: 1fr; opacity: 1; background: color-mix(in srgb, var(--good) 24%, transparent); }
		100% { grid-template-rows: 1fr; opacity: 1; background: transparent; }
	}

	@media (prefers-reduced-motion: reduce) {
		.state-before,
		.state-after,
		.morph-code {
			transition: none;
		}

		.after .line-removed {
			animation: none;
			display: none;
		}

		.after .line-added {
			animation: none;
			grid-template-rows: 1fr;
			opacity: 1;
		}
	}
</style>
