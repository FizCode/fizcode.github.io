---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<div class="tile">
  <dt class="type-tag">{label}</dt>
  <dd class="type-title-md">{value}</dd>
</div>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: 20px 22px;
    border-radius: var(--shape-lg);
    background: var(--color-surface-container);
  }
  dt { color: var(--color-on-surface-variant); }
  dd { margin: 0; }
</style>
