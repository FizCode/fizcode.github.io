---
import Button from "@/components/ui/Button.astro";
import GlassChip from "@/components/ui/GlassChip.astro";
---

<section id="top" class="container hero">
  <p class="type-eyebrow muted">
    FizCode — Android developer, ex-UI/UX designer
  </p>
  <h1 class="type-display-lg">
    Android apps, <strong>designed and built</strong> by the same person.
  </h1>
  <p class="type-body-lg muted intro">
    Kotlin, Jetpack Compose and Kotlin Multiplatform, with the eye of someone
    who used to write the design specs.
  </p>
  <div class="actions">
    <Button href="#work">See selected work</Button>
    <GlassChip status>Open to Android &amp; KMP roles</GlassChip>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-36);
    padding-block: var(--space-120) var(--space-140);
  }
  p,
  h1 {
    margin: 0;
  }
  h1 {
    max-width: 860px;
  }
  .intro {
    max-width: 520px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
  }
</style>
