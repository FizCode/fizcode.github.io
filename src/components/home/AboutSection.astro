---
import { site } from '@/data/site';
---

<section id="about" class="container about reveal">
  <h2 class="type-title-lg">About</h2>
  <div class="body">
    <p class="type-headline-sm">
      I started in UI/UX, handing off designs. Now I’m the developer who builds them, and the one who catches the{' '}
      <strong>3dp misalignment</strong> in code review.
    </p>
    <p class="type-body-sm skills muted">{site.skills.join(' · ')}</p>
  </div>
</section>

<style>
  .about {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-48);
    padding-block: 80px;
  }
  h2, p { margin: 0; }
  h2 { flex: 1 1 240px; }
  .body { flex: 3 1 520px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-28); }
  .skills { line-height: 1.7; }
</style>
