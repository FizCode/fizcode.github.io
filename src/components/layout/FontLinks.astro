---
// Fonts load without blocking the first paint (text shows in a fallback font, then swaps).
// Only the weights the site uses are requested: Roboto Flex's width and optical-size axes alone
// cost about 150 KB and nothing uses them. JetBrains Mono's bold is used by the code slides.
const href =
  'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400..700&family=Plus+Jakarta+Sans:wght@300..800&family=Roboto+Flex:wght@400..700&display=swap';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href={href} onload="this.onload=null;this.rel='stylesheet'" />
<noscript><link rel="stylesheet" href={href} /></noscript>
