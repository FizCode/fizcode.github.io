---
import { navItems, type DockAction, type NavId } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import NavItem from '@/components/ui/NavItem.astro';

interface Props {
  current: NavId;
  /** Follow the reader through the page's sections instead of staying on `current` */
  scrollSpy?: boolean;
  /** Where the round button leads; without one the button shrinks away */
  action?: DockAction;
}

const { current, scrollSpy = false, action } = Astro.props;
---

<div class="dock" data-dock>
  <nav aria-label="Quick navigation" class="bar" data-scroll-spy={scrollSpy ? '' : undefined}>
    {navItems.map((item) => (
      <NavItem href={`/#${item.target}`} icon={item.icon} label={item.label} active={item.id === current} />
    ))}
  </nav>
  <a
    href={action?.href}
    class:list={['fab', { gone: !action }]}
    aria-label={action?.label}
    aria-hidden={action ? undefined : 'true'}
    tabindex={action ? undefined : -1}
  >
    <Icon name="arrow-right" size="lg" bold />
  </a>
</div>

<script>
  import { watchDock } from '@/scripts/dock-compact';
  import { spySections } from '@/scripts/scroll-spy';

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) watchDock(dock);

  const nav = document.querySelector<HTMLElement>('[data-scroll-spy]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav-item]')];
    spySections(links, (active) =>
      links.forEach((link) => {
        if (link === active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }),
    );
  }
</script>

<style>
  .dock {
    position: sticky;
    bottom: var(--space-24);
    z-index: 6;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 var(--space-16) var(--space-24);
    pointer-events: none;
    transform-origin: 50% 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dock { transition: transform var(--duration-medium) var(--ease-spring); }
    .dock[data-compact] { transform: scale(0.9); }
  }
  .bar,
  .fab { pointer-events: auto; }
  .bar {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-8);
    border-radius: var(--shape-full);
    background: var(--glass-fill);
    border: 1px solid var(--glass-edge);
    box-shadow: var(--elevation-glass);
    backdrop-filter: blur(var(--blur-xl)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--blur-xl)) saturate(var(--glass-saturate));
  }
  .fab {
    width: var(--fab-size);
    height: var(--fab-size);
    border-radius: var(--fab-radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
    box-shadow: var(--elevation-glass);
    margin-left: var(--space-12);
  }
  .fab:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }

  /* No next project: the button shrinks away and the navigation slides back to the middle */
  @keyframes shrink-away {
    to {
      width: 0;
      margin-left: 0;
      opacity: 0;
      transform: scale(0);
    }
  }
  .gone {
    pointer-events: none;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gone {
      visibility: visible;
      animation: shrink-away var(--duration-long) var(--ease-spring) 400ms forwards;
    }
  }

  @media (max-width: 640px) {
    .dock { padding: 0 var(--space-8) var(--space-16); }
    .bar { padding: 6px; gap: 6px; }
    .fab { display: none; }
  }
</style>
