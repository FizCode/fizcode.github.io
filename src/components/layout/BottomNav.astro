---
import { navItems, type DockAction } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import NavItem from '@/components/ui/NavItem.astro';

interface Props {
  /** The round button: where it leads, and its accessible name */
  action: DockAction;
}

const { action } = Astro.props;
---

<div class="dock" data-dock>
  <nav aria-label="Quick navigation" class="bar" data-scroll-spy>
    {navItems.map((item, i) => (
      <NavItem href={`#${item.target}`} icon={item.icon} label={item.label} active={i === 0} />
    ))}
  </nav>
  <a href={action.href} class="fab" aria-label={action.label}>
    <Icon name="arrow-right" size="lg" bold />
  </a>
</div>

<script>
  import { watchDock } from '@/scripts/dock-compact';
  import { spySections } from '@/scripts/scroll-spy';

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) watchDock(dock);

  const nav = document.querySelector<HTMLElement>('[data-scroll-spy]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav-item]')];
    spySections(links, (active) =>
      links.forEach((link) => {
        if (link === active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }),
    );
  }
</script>

<style>
  .dock {
    position: sticky;
    bottom: var(--space-24);
    z-index: 6;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 var(--space-16) var(--space-24);
    pointer-events: none;
    transform-origin: 50% 100%;
  }
  .dock[data-compact] { transform: scale(var(--dock-scale-compact)); }
  @media (prefers-reduced-motion: no-preference) {
    .dock { transition: transform var(--duration-medium) var(--ease-spring); }
  }
  .bar,
  .fab { pointer-events: auto; }
  .bar {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-8);
    border-radius: var(--shape-full);
    background: var(--glass-fill);
    border: 1px solid var(--glass-edge);
    box-shadow: var(--elevation-glass);
    backdrop-filter: blur(var(--blur-xl)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--blur-xl)) saturate(var(--glass-saturate));
  }
  .fab {
    width: var(--fab-size);
    height: var(--fab-size);
    border-radius: var(--fab-radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
    box-shadow: var(--elevation-glass);
    margin-left: var(--space-12);
  }
  /* Same morph as the arrow on the project cards */
  @media (prefers-reduced-motion: no-preference) {
    .fab {
      transition:
        border-radius var(--duration-long) var(--ease-spring),
        transform var(--duration-long) var(--ease-spring);
    }
  }
  .fab:hover,
  .fab:focus-visible {
    border-radius: var(--fab-radius-hover);
    transform: rotate(-45deg);
  }
  .fab:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 3px; }

  @media (max-width: 640px) {
    .dock { padding: 0 var(--space-8) var(--space-16); }
    .bar { padding: 6px; gap: 6px; }
    .fab { display: none; }
  }
</style>
