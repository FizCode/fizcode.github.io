---
import { icons } from '@/data/icons';
import { site } from '@/data/site';

interface Props {
  /** Less space above, for pages where the content before it already ends with space (project pages) */
  tight?: boolean;
}

const { tight = false } = Astro.props;
import TextLink from '@/components/ui/TextLink.astro';
---

<section id="contact" class:list={['container', 'contact', 'reveal', { tight }]}>
  <p class="type-eyebrow muted">Have an app in mind?</p>
  <a href={`mailto:${site.email}`} class="type-display-md cta">Let’s talk <span class="arrow"><svg aria-hidden="true" viewBox="0 0 24 24" set:html={icons.send} /></span></a>
  <div class="links">
    {site.socials.map((social) => <TextLink href={social.href}>{social.label}</TextLink>)}
  </div>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
    padding-block: var(--space-96) var(--space-72);
    /* Blank space below, so the sections above can scroll all the way up to the top of the screen.
       The bottom navigation takes ~90px under this section, so the page ends with the heading near the top. */
    min-height: calc(100svh - 168px);
  }
  p { margin: 0; }
  .cta { text-decoration: none; }
  .cta:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 4px; border-radius: 8px; }
  .arrow { color: var(--color-primary); }
  .arrow svg {
    display: inline; /* base.css makes every svg a block, which would drop it under the text */
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.12em;
    vertical-align: -0.04em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tight { padding-top: var(--space-48); }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-24); }
</style>
