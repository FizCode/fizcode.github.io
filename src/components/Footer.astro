---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-content">
      <p class="copyright">&copy; {currentYear} &lt;FizCode/&gt;</p>

      <div class="social-links">
        <a href="https://github.com/fizcode" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://linkedin.com/in/fizcode" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://medium.com/@fizcode" target="_blank" rel="noopener noreferrer">Medium</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--spacing-lg) 0;
    border-top: 1px solid var(--color-border);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .copyright {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .social-links {
    display: flex;
    gap: var(--spacing-md);
  }

  .social-links a {
    color: var(--color-text-main);
    font-size: 0.95rem;
  }
</style>
