---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link?: string;
  slug?: string;
  /** Dark card, for the top project */
  featured?: boolean;
}

const { title, description, tags, link, slug, featured = false } = Astro.props;
const href = slug ? `/projects/${slug}` : link || '#';
// The first few tags make the card's stack line; the full list is on the project page
const stack = tags.slice(0, 3).join(' · ');
---

<article class:list={['project-card', { featured }]}>
  <p class="stack">{stack}</p>
  <h3 class="card-title">
    <a href={href}>{title}</a>
  </h3>
  <p class="card-description">{description}</p>
  <span class="link-arrow" aria-hidden="true">View project →</span>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    height: 100%;
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .project-card:hover {
    border-color: var(--color-ink);
    transform: translateY(-3px);
  }

  .stack {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .card-title {
    font-size: 1.625rem;
  }

  /* The whole card is the link */
  .card-title a::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-title a:hover {
    color: inherit;
  }

  .card-description {
    flex-grow: 1;
    color: var(--color-text-body);
    line-height: 1.5;
  }

  .link-arrow {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .featured {
    background: var(--color-panel);
    border-color: var(--color-panel-border);
    color: var(--color-on-panel);
  }

  .featured:hover {
    border-color: var(--color-ink);
  }

  .featured .stack {
    color: #9cc9b0;
  }

  .featured .card-title {
    color: var(--color-on-panel);
  }

  .featured .card-description {
    color: #c9c7bf;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }
</style>
